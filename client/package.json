{
  "name": "@storio/wss-relay-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "proto": "../.tools/bin/protoc --plugin=protoc-gen-es=./node_modules/.bin/protoc-gen-es --es_out=src/relay/gen --es_opt=target=ts -I ../api ../api/relay/v2/relay.proto",
    "check": "node --experimental-transform-types scripts/check-sdk.ts",
    "build:app": "MINB_APP_PLATFORM=android npm run build",
    "android:sync": "npm run build:app && cap sync android"
  },
  "exports": {
    "./relay": "./src/relay/client.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.9",
    "@minbgames/web-kit": "file:MinbWebKit",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@capacitor/android": "7.6.9",
    "@capacitor/cli": "7.6.9",
    "@types/node": "26.6.5",
    "typescript": "6.0.2",
    "vite": "8.3.5"
  }
}
