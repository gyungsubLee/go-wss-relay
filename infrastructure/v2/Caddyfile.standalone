# A single staging origin serves both the public API and the WebSocket relay.
{$STANDALONE_DOMAIN} {
	handle /v2/api/* {
		reverse_proxy 127.0.0.1:8090
	}
	handle /v2/relay {
		reverse_proxy 127.0.0.1:8090 {
			stream_timeout 2h
		}
	}
	handle /healthz {
		reverse_proxy 127.0.0.1:8090
	}
	handle /readyz {
		reverse_proxy 127.0.0.1:8090
	}
	handle {
		respond 404
	}
}
