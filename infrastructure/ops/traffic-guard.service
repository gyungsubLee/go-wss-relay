[Unit]
Description=WSS relay conservative monthly transfer guard
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/wss-relay/traffic.env
ExecStart=/opt/wss-relay/ops/check-traffic-budget.sh
TimeoutStartSec=60
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/wss-relay /run/systemd/system
