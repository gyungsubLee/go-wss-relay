RELAY_ARGS=--role relay --node-id node-a --listen 127.0.0.1:8090 --management-listen 127.0.0.1:8091 --public-url wss://node-a.example.com/v2/relay --operator-token-file /etc/wss-relay/secrets/node-a.token --allowed-origin play.example.com --allowed-origin localhost --trusted-proxy 127.0.0.1/32 --max-rooms 512 --max-participants 200 --traffic-config /etc/wss-relay/traffic.json
